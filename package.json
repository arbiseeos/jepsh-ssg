{
  "name": "jepsh-ssg",
  "description": "A static site generator for modern web frameworks with route crawling and hydration support",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "author": "Jepsh Team <maintainers@os.arbisee.com>",
  "homepage": "https://os.arbisee.com/jepsh-ssg",
  "keywords": [
    "jepsh",
    "static-site-generator",
    "ssg",
    "prerender",
    "web-crawler",
    "react",
    "vite",
    "vue",
    "svelte",
    "hydration",
    "puppeteer",
    "cli"
  ],
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jepsh-ssg": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arbiseeos/jepsh-ssg.git"
  },
  "bugs": {
    "url": "https://github.com/arbiseeos/jepsh-ssg/issues"
  },
  "scripts": {
    "dev": "node bin/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{bin,src,tests}/**/*.js\" eslint.config.js",
    "format:check": "prettier --check \"{bin,src,tests}/**/*.js\" eslint.config.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "c8 --reporter=text --reporter=html node --test \"tests/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "beasties": "^0.5.4",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "inquirer": "^12.6.3",
    "ora": "^8.2.0",
    "p-limit": "^6.2.0",
    "pretty-bytes": "^7.0.0",
    "puppeteer": "^25.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "c8": "^10.1.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
